{
  "name": "rasa-undangan",
  "version": "1.0.0",
  "private": true,
  "description": "Rasa Undangan - premium multi-tenant digital invitation & RSVP SaaS",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "bash scripts/prisma-generate.sh && next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "bash scripts/prisma-generate.sh && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "bash scripts/prisma-generate.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dev": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "FORCE_SEED=true npm run db:seed",
    "setup": "bash scripts/setup.sh",
    "postinstall": "bash scripts/prisma-generate.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@aws-sdk/s3-request-presigner": "3.1168.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@prisma/client-engine-runtime": "^6.19.3",
    "@radix-ui/react-slot": "1.5.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.3.1",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.72.0",
    "next": "16.4.2",
    "nodemailer": "^7.0.11",
    "papaparse": "5.7.1",
    "pdfkit": "0.20.2",
    "pg": "^8.20.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^7.0.5",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
