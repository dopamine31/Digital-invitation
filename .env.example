# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key
CSRF_SALT=change-me-csrf-salt

# ---- Database ----
DATABASE_URL=postgresql://rasa:rasa@localhost:5432/rasa?schema=public
# Docker Compose value: postgresql://rasa:rasa@postgres:5432/rasa?schema=public

# ---- Redis (cache / queue / rate limit) ----
REDIS_URL=redis://localhost:6379
# Docker Compose value: redis://redis:6379

# ---- S3-compatible storage (MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rasa-media
S3_ACCESS_KEY=rasa
S3_SECRET_KEY=rasa-secret-change-me
S3_FORCE_PATH_STYLE=true

# ---- Auth providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Notification adapters (mock | smtp | fonnte | watzap | meta) ----
WHATSAPP_ADAPTER=mock
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
EMAIL_ADAPTER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rasa Undangan <no-reply@rasa.id>"

# ---- Payment adapters (mock | midtrans | xendit) ----
PAYMENT_ADAPTER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# ---- Platform ----
DEFAULT_LOCALE=id
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Jakarta
MAINTENANCE_MODE=false
SUPER_ADMIN_EMAIL=superadmin@rasa.id
SUPER_ADMIN_PASSWORD=SuperAdmin!234
SEED_DEMO_DATA=true
WORKER_CONCURRENCY=5
BLAST_THROTTLE_PER_MINUTE=60
LOG_LEVEL=info
